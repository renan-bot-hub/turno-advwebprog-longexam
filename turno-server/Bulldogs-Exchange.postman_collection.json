{
  "info": {
    "name": "Bulldogs Exchange API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "productId", "value": "replace-with-product-id" },
    { "key": "categoryId", "value": "replace-with-category-id" },
    { "key": "userId", "value": "replace-with-user-id" },
    { "key": "orderId", "value": "replace-with-order-id" },
    { "key": "reviewId", "value": "replace-with-review-id" }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Products (Base)",
      "item": [
        {
          "name": "List all products",
          "request": { "method": "GET", "url": "{{baseUrl}}/product" }
        },
        {
          "name": "Pagination - page 1 limit 5",
          "request": { "method": "GET", "url": "{{baseUrl}}/product?page=1&limit=5" }
        },
        {
          "name": "Filter by category",
          "request": { "method": "GET", "url": "{{baseUrl}}/product?category=Campus%20Apparel" }
        },
        {
          "name": "Sort by price ascending",
          "request": { "method": "GET", "url": "{{baseUrl}}/product?sort=price&order=asc" }
        },
        {
          "name": "Get product by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/product/{{productId}}" }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"nu-test-notebook\",\n  \"title\": \"Bulldog Study Notebook\",\n  \"category\": \"Study Supplies\",\n  \"price\": 299,\n  \"stock\": 20,\n  \"description\": \"A lined notebook for campus notes.\",\n  \"imageUrl\": \"\"\n}"
            },
            "url": "{{baseUrl}}/product"
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"nu-test-notebook\",\n  \"title\": \"Bulldog Study Notebook - Updated\",\n  \"category\": \"Study Supplies\",\n  \"price\": 349,\n  \"stock\": 18,\n  \"description\": \"Updated campus notes notebook.\",\n  \"imageUrl\": \"\"\n}"
            },
            "url": "{{baseUrl}}/product/{{productId}}"
          }
        },
        {
          "name": "Delete product",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/product/{{productId}}" }
        }
      ]
    },
    {
      "name": "Products v1 (Advanced)",
      "item": [
        {
          "name": "v1 - List all products",
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/product" }
        },
        {
          "name": "v1 - Pagination",
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/product?page=1&limit=5" }
        },
        {
          "name": "v1 - Filter by category",
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/product?category=Campus%20Apparel" }
        },
        {
          "name": "v1 - Filter by category + supplier",
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/product?category=Campus%20Apparel&supplier=Nike" }
        },
        {
          "name": "v1 - Keyword search",
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/product?search=jacket" }
        },
        {
          "name": "v1 - Sort by price",
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/product?sort=price&order=asc" }
        },
        {
          "name": "v1 - All combined (page + filter + sort + search)",
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/product?page=1&limit=5&category=Campus%20Apparel&sort=price&order=asc&search=jacket" }
        },
        {
          "name": "v1 - Get product by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/v1/product/{{productId}}" }
        },
        {
          "name": "v1 - Create product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"nu-v1-jacket\",\n  \"title\": \"Bulldog Varsity Jacket\",\n  \"category\": \"Campus Apparel\",\n  \"supplier\": \"Nike\",\n  \"price\": 1299,\n  \"stock\": 10,\n  \"description\": \"Official NU varsity jacket.\",\n  \"imageUrl\": \"\"\n}"
            },
            "url": "{{baseUrl}}/v1/product"
          }
        },
        {
          "name": "v1 - Update product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"nu-v1-jacket\",\n  \"title\": \"Bulldog Varsity Jacket - Updated\",\n  \"category\": \"Campus Apparel\",\n  \"supplier\": \"Nike\",\n  \"price\": 1499,\n  \"stock\": 8,\n  \"description\": \"Updated NU varsity jacket.\",\n  \"imageUrl\": \"\"\n}"
            },
            "url": "{{baseUrl}}/v1/product/{{productId}}"
          }
        },
        {
          "name": "v1 - Delete product",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/v1/product/{{productId}}" }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List all categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/category" }
        },
        {
          "name": "Get category by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/category/{{categoryId}}" }
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Study Supplies\",\n  \"description\": \"Notebooks, pens, and school essentials.\",\n  \"imageUrl\": \"\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/category"
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Study Supplies - Updated\",\n  \"description\": \"Updated description.\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/category/{{categoryId}}"
          }
        },
        {
          "name": "Delete category",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/category/{{categoryId}}" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List all users",
          "request": { "method": "GET", "url": "{{baseUrl}}/user" }
        },
        {
          "name": "Get user by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/user/{{userId}}" }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"dela Cruz\",\n  \"email\": \"juan@nu.edu.ph\",\n  \"password\": \"password123\",\n  \"role\": \"buyer\"\n}"
            },
            "url": "{{baseUrl}}/user"
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"dela Cruz - Updated\",\n  \"email\": \"juan@nu.edu.ph\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/user/{{userId}}"
          }
        },
        {
          "name": "Delete user",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/user/{{userId}}" }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List all orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/order" }
        },
        {
          "name": "Filter orders by status",
          "request": { "method": "GET", "url": "{{baseUrl}}/order?status=pending" }
        },
        {
          "name": "Get order by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/order/{{orderId}}" }
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"{{userId}}\",\n  \"items\": [],\n  \"total\": 0,\n  \"shippingAddress\": \"123 NU Sampaloc, Manila\",\n  \"paymentMethod\": \"cash\"\n}"
            },
            "url": "{{baseUrl}}/order"
          }
        },
        {
          "name": "Update order status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipped\"\n}"
            },
            "url": "{{baseUrl}}/order/{{orderId}}"
          }
        },
        {
          "name": "Delete order",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/order/{{orderId}}" }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "List all reviews",
          "request": { "method": "GET", "url": "{{baseUrl}}/review" }
        },
        {
          "name": "Filter reviews by product",
          "request": { "method": "GET", "url": "{{baseUrl}}/review?productId={{productId}}" }
        },
        {
          "name": "Get review by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/review/{{reviewId}}" }
        },
        {
          "name": "Create review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"{{userId}}\",\n  \"product\": \"{{productId}}\",\n  \"rating\": 5,\n  \"comment\": \"Great product! Highly recommended.\"\n}"
            },
            "url": "{{baseUrl}}/review"
          }
        },
        {
          "name": "Update review",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Good product, updated review.\"\n}"
            },
            "url": "{{baseUrl}}/review/{{reviewId}}"
          }
        },
        {
          "name": "Delete review",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/review/{{reviewId}}" }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get cart by user ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/cart/{{userId}}" }
        },
        {
          "name": "Create cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"{{userId}}\",\n  \"items\": [],\n  \"total\": 0\n}"
            },
            "url": "{{baseUrl}}/cart"
          }
        },
        {
          "name": "Update cart",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [],\n  \"total\": 0\n}"
            },
            "url": "{{baseUrl}}/cart/{{userId}}"
          }
        },
        {
          "name": "Delete cart",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/cart/{{userId}}" }
        }
      ]
    }
  ]
}
