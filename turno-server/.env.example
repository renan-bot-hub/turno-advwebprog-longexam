PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bulldogs_exchange

# Required: any long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: comma-separated extra client origins allowed by CORS (e.g. a deployed frontend)
CLIENT_URL=

# Optional: set to true to fall back to a temporary in-memory database when MongoDB is unreachable
USE_MEMORY_DB=false

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@bulldogex.com
ADMIN_PASSWORD=admin1234

# Product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
